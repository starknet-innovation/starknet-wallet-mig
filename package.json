{
  "name": "starknet-wallet-migrator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Migrate ERC-20 tokens and NFTs from one Starknet wallet to another in a single signed multicall.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "starknet": "8.9.2",
    "starknetkit": "3.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "axios": "1.18.0",
    "viem": {
      "ws": "8.21.0"
    }
  }
}
